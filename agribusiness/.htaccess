# App AgriBusiness (carpeta agribusiness/ del catálogo). Desde el navegador solo
# deben verse index.html, app.json, icon.svg, app/, assets/ y api/ (que tiene sus
# propios .htaccess).

# La memoria del proyecto y cualquier .md, y los archivos ocultos.
<FilesMatch "(\.md$|^\.)">
  Require all denied
</FilesMatch>

# Diseño y transcripciones (project/ tiene Excel de clientes).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(chats|project)(/|$) - [F,L]
</IfModule>

# Cabeceras de seguridad: la app no se puede incrustar en otra web, el navegador
# no adivina tipos de archivo y el enlace con ?token= no se envía a otros sitios.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# La interfaz (app/*.js) se edita sin compilar: que el navegador compruebe
# siempre si hay una versión nueva en lugar de usar la copia de su caché.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
