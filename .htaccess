# La raíz del repositorio es también la raíz de la app. Desde el navegador solo
# deben verse index.html, assets/ y api/ (que tiene sus propios .htaccess).

# La memoria del proyecto y cualquier .md, y los archivos ocultos (.gitignore…).
<FilesMatch "(\.md$|^\.)">
  Require all denied
</FilesMatch>

# Diseño, transcripciones y el propio repositorio git.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(chats|project|\.git)(/|$) - [F,L]
</IfModule>

# La interfaz (app/*.js) se edita sin compilar: que el navegador compruebe
# siempre si hay una versión nueva en lugar de usar la copia de su caché.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
